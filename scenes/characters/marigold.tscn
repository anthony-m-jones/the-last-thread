[node name="Marigold" type="Node2D"]
script = ExtResource("npc")

; scale 0.13: 1240x826 art -> ~161x107 world units. Marigold is an old house cat,
; about the hero's size (a touch grander). Tune scale + position.y in the editor
; so her paws rest on her platform. Leave face_player on (she looks at you while
; you talk); set face_player off + static_facing in the Inspector if you want her
; gazing at the dew instead.
[node name="AnimatedSprite2D" type="AnimatedSprite2D" parent="."]
scale = Vector2(0.13, 0.13)
sprite_frames = SubResource("frames_marigold")
animation = &"idle"
autoplay = "idle"
