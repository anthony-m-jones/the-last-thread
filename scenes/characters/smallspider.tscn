; scale 0.09: 599x496 art -> ~54x45 world units. A small, gentle creature, much
; smaller than the cats. Tune scale + position in the editor. face_player is OFF
; (these are ambient critters, not conversation partners); set static_facing in
; the Inspector per copy if you want some looking left and some right.
[node name="AnimatedSprite2D" type="AnimatedSprite2D" parent="."]
scale = Vector2(0.09, 0.09)
sprite_frames = SubResource("frames_spider")
animation = &"idle"
autoplay = "idle"
